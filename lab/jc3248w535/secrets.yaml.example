wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

ap_fallback_password: "oracleface"

# Run `make rand` to generate fresh strong values for these:
api_encryption_key: "GENERATE_WITH_make_rand"
ota_password: "GENERATE_WITH_make_rand"

# Family MQTT broker — xiaoer-oracle publishes brewing state here
mqtt_broker: "mqtt.example.com"
mqtt_username: "YOUR_MQTT_USER"
mqtt_password: "YOUR_MQTT_PASSWORD"
