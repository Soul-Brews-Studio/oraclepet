{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oracle App",
  "version": "0.1.0",
  "identifier": "studio.soul-brews.oracle-app-tauri",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Oracle App",
        "width": 400,
        "height": 640,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
