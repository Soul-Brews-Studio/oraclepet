# JC3248 App Gallery — flash one numbered app at a time.
#   make list           # show all apps
#   make build N=1      # compile app 001
#   make flash N=1      # compile + upload app 001
#   make run   N=1      # compile + upload + open serial monitor (one shot)
#   make monitor        # just the serial monitor (Ctrl-C to quit)
#   make flash N=5 PORT=/dev/cu.usbmodemXXXX
PORT ?= /dev/cu.usbmodem13301
N    ?= 0
ENV   = jc3248w535c
# Resolve pio: PATH first, then the standard PlatformIO venv (make runs recipes
# via /bin/sh, which doesn't see interactive shell aliases — so fall back here).
PIO  := $(shell command -v pio 2>/dev/null || echo $(HOME)/.platformio/penv/bin/pio)

.PHONY: list build flash run monitor reindex
list:
	@echo "JC3248 App Gallery — flash with: make flash N=<num>"
	@ls src/apps/app_*.h 2>/dev/null | sed -E 's#.*/app_([0-9]+)_(.+)\.h#  \1  \2#'

build:
	PLATFORMIO_BUILD_FLAGS="-DAPP=$(N)" $(PIO) run -e $(ENV)

flash:
	PLATFORMIO_BUILD_FLAGS="-DAPP=$(N)" $(PIO) run -e $(ENV) -t upload --upload-port $(PORT)

# Compile + upload + open the serial monitor in one shot (handles USB-CDC
# re-enumeration after reset). Ctrl-C to quit the monitor.
run:
	PLATFORMIO_BUILD_FLAGS="-DAPP=$(N)" $(PIO) run -e $(ENV) -t upload -t monitor --upload-port $(PORT)

monitor:
	$(PIO) device monitor -p $(PORT) -b 115200

# Rebuild apps/index.h from the app headers present (run after adding apps).
# Also emits a guard so flashing a number with no app gives a CLEAR #error
# instead of the cryptic "'app_setup' was not declared in this scope".
reindex:
	@{ echo '#pragma once'; \
	   echo '// Auto-generated by `make reindex`. Do not edit.'; \
	   ls src/apps/app_*.h | sed -E 's|src/apps/(.+)|#include "\1"|'; \
	   nums=$$(ls src/apps/app_*.h | sed -E 's#.*/app_0*([0-9]+)_.*#APP==\1#' | paste -sd'|' - | sed 's/|/ || /g'); \
	   echo "#if !($$nums)"; \
	   echo '#error "No app for this APP number. Run: make list  (then: make flash N=<valid number>)"'; \
	   echo '#endif'; } > src/apps/index.h
	@echo "reindexed src/apps/index.h:"; cat src/apps/index.h
