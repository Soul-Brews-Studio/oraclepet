{
  "name": "esp32-oracle-sim-gallery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "One React gallery for every esp32-oracle simulator (pet, oracle-face v1/v2, gif-wasm) — host-side LVGL+SDL→WASM mounted into React routes.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5174",
    "build:sims": "make -C .. -f sim-gallery/Makefile build-sims",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dry": "pnpm build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wrangler": "^4.95.0"
  }
}
