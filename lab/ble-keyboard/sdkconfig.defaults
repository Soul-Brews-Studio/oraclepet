# ESP32-S3 BLE-only HID Host (S3 has NO classic BT)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
# NO CONFIG_BT_HID_HOST_ENABLED — that's classic BT, S3 doesn't have it
# NO CONFIG_BT_HID_ENABLED — same
# NO CONFIG_BT_CLASSIC_ENABLED — S3 is BLE-only
CONFIG_GATTC_ENABLE=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_GATTC_NOTIF_REG_MAX=16

# PSRAM (N16R8 board)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
